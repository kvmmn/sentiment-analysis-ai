# Local Python environment.
.venv/

# Local datasets; retain the documentation.
/data/*
!/data/README.md

# Local credentials and secrets.
.env
.env.*
*.pem
*.key
credentials.json
secrets.json
secrets.yaml
secrets.yml

# Operating-system clutter.
.DS_Store
._*
Thumbs.db
Desktop.ini

# Local developer-console evidence and temporary PDF renders.
/tmp/pdfs/
/scraper.log
/debug/

# Local-only workspace (everything except this README).
/_local/*
!/_local/README.md

# LinkedIn scraper runtime artifacts (do not commit).
/linkedin-scraper/linkedin_session/
/linkedin-scraper/linkedin_posts.db
/linkedin-scraper/scraper.log
/linkedin-scraper/debug/
