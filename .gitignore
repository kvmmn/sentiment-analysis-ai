# Local Python environment.
.venv/

# Local datasets; retain the documentation.
/data/*
!/data/README.md

# Local credentials and secrets.
.env
.env.*
*.pem
*.key
credentials.json
secrets.json
secrets.yaml
secrets.yml

# Operating-system clutter.
.DS_Store
._*
Thumbs.db
Desktop.ini

# Local developer-console evidence and temporary PDF renders.
/tmp/pdfs/
/scraper.log
/debug/

# Local-only workspace (everything except this README).
/_local/*
!/_local/README.md

# LinkedIn scraper runtime artifacts (do not commit; exports contain personal data).
/src/linkedin-scraper/linkedin_session/
/src/linkedin-scraper/*.csv
/src/linkedin-scraper/*.db
/src/linkedin-scraper/*.db-*
/src/linkedin-scraper/scraper.log
/src/linkedin-scraper/debug/
# Protect legacy paths in older checkouts and CWD-relative submission outputs.
/linkedin-scraper/linkedin_session/
/linkedin-scraper/*.csv
/linkedin-scraper/*.db
/linkedin-scraper/scraper.log
/linkedin-scraper/debug/
corpus_data/
__pycache__/
*.py[cod]
